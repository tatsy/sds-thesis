% sdsthesis.sty
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sdsthesis}[Aug. 20th, 2024, Tatsuya Yatagawa]

% ------------------------------------------------------------------------------
% スタイルファイルオプションの設定
% ------------------------------------------------------------------------------
\RequirePackage{iftex}
\RequirePackage{ifthen}
\RequirePackage{xparse}
\RequirePackage{letltxmacro}
\RequirePackage{expl3}
\RequirePackage{l3keys2e}

\ExplSyntaxOn
  % 言語設定のオプション
  \bool_new:N \l_thesis_english_bool
  \bool_gset_false:N \l_thesis_english_bool

  % ロゴの表示のオプション
  \bool_new:N \l_thesis_nologo_bool
  \bool_gset_false:N \l_thesis_nologo_bool

  % オプションの処理
  \keys_define:nn {sdsthesis}{
    english .bool_set:N = \l_thesis_english_bool,
    nologo .bool_set:N = \l_thesis_nologo_bool,
    unknown .code:n = {
      \PackageWarning{sdsthesis}{Unknown option `\CurrentOption' ignored}
    },
  }
  \ProcessKeysOptions{sdsthesis}

  % LuaTeXかXeTeXのみをサポート
  \sys_if_engine_luatex:F
  {
    \sys_if_engine_xetex:F
    {
      \PackageError{sdsthesis}{Only XeTeX and LuaTeX are supported}
    }
  }
\ExplSyntaxOff

% ------------------------------------------------------------------------------
% 必要なパッケージ
% ------------------------------------------------------------------------------
\RequirePackage{mathtools}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage{color}
\RequirePackage[svgnames,dvipsnames,x11names]{xcolor}
\RequirePackage[pagestyles]{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{fancybox}
\RequirePackage{emptypage}
\RequirePackage{xspace}
\RequirePackage{charter}
\RequirePackage[title]{appendix}

\ifluatex
  \RequirePackage[luatex]{graphicx}
\fi

\ifxetex
  \RequirePackage[xetex]{graphicx}
\fi

% ------------------------------------------------------------------------------
% フォントの設定
% ------------------------------------------------------------------------------

% LuaTeX用の設定
\ifluatex
  \RequirePackage[no-math]{luatexja}
  \RequirePackage[haranoaji]{luatexja-preset}
\fi

% XeTeX用の設定
\ifxetex
  \RequirePackage{fontspec}
  \RequirePackage{zxjatype}
  \RequirePackage[haranoaji]{zxjafont}
  \newlength{\zw}
  \setlength{\zw}{1em}
  \newlength{\zh}
  \setlength{\zh}{1.1\zw}
\fi

% ------------------------------------------------------------------------------
% 英文・数式フォントの設定
% ------------------------------------------------------------------------------

\RequirePackage[math-style=ISO]{unicode-math}
\unimathsetup{math-style=TeX,bold-style=TeX}
\setmainfont{STIX Two Text}[Scale=1.0]
\setmathfont{STIX Two Math}[Scale=1.0]
\setsansfont{Roboto}[Scale=1.0, BoldFont=Roboto Medium, ItalicFont=Roboto Italic, BoldItalicFont=Roboto Medium Italic]

\AtBeginDocument{\renewcommand{\mathbf}[1]{\symbf{#1}}}
\AtBeginDocument{\renewcommand{\mathrm}[1]{\symrm{#1}}}
\AtBeginDocument{\renewcommand{\mathit}[1]{\symit{#1}}}
\AtBeginDocument{\newcommand{\bm}[1]{\symbfit{#1}}}

% 数式の下付き・上付き文字のサイズを調整
\RequirePackage{latexsym}
\DeclareMathSizes{10}{10}{7}{7}
\DeclareMathSizes{10.5}{11}{7}{7} % For size 10 text
\DeclareMathSizes{11}{12}{6.5}{6.5} % For size 11 text
\DeclareMathSizes{12}{13}{7}{7} % For size 12 text

% ------------------------------------------------------------------------------
% 句読点の自動置換
% ------------------------------------------------------------------------------
\RequirePackage{newunicodechar}
\newunicodechar{。}{．}
\newunicodechar{、}{，}
\newunicodechar{⭕}{\raisebox{.2ex}{$\bigcirc$}}
\newunicodechar{○}{\raisebox{.2ex}{$\bigcirc$}}
\newunicodechar{◯}{\raisebox{.2ex}{$\bigcirc$}}
\newunicodechar{☓}{$\times$}

% ------------------------------------------------------------------------------
% SI単位系の表示を調整
% ------------------------------------------------------------------------------
\RequirePackage{siunitx}
\sisetup{
  group-separator={,},
}

% ------------------------------------------------------------------------------
% ページの設定
% ------------------------------------------------------------------------------
% 1inch = 25.4 mm
% A4 210mm×297mm
\RequirePackage{geometry}
\ExplSyntaxOn
  % ページの幅と高さ
  \dim_new:N \l_page_width_dim
  \dim_set:Nn \l_page_width_dim {210mm}
  \dim_new:N \l_page_height_dim
  \dim_set:Nn \l_page_height_dim {297mm}
  \dim_new:N \l_text_width_dim
  \dim_set:Nn \l_text_width_dim {160mm}
  \dim_new:N \l_text_height_dim
  \dim_set:Nn \l_text_height_dim {224mm}
  \dim_new:N \l_left_margin_dim
  \dim_set:Nn \l_left_margin_dim {24mm}
  \dim_new:N \l_head_height_dim
  \dim_set:Nn \l_head_height_dim {5mm}
  \geometry{
    textwidth={\dim_use:N \l_text_width_dim},
    textheight={\dim_use:N \l_text_height_dim},
    left={\dim_use:N \l_left_margin_dim},
    headheight={\dim_use:N \l_head_height_dim},
  }
\ExplSyntaxOff

% ページのコンテンツを上に詰める
\raggedbottom

% ------------------------------------------------------------------------------
% 各種サイズ
% ------------------------------------------------------------------------------
\ExplSyntaxOn
\bool_if:nTF {\l_thesis_english_bool}{
}{
  \RequirePackage{indentfirst}
  \setlength{\parindent}{1\zw}
  \renewcommand{\baselinestretch}{1.2}
}
\ExplSyntaxOff

% ------------------------------------------------------------------------------
% 章，節などの設定
% ------------------------------------------------------------------------------
\ExplSyntaxOn
\bool_if:NTF {\l_thesis_english_bool}{
  \titleformat{\chapter}[display]{\LARGE\sffamily\bfseries}{Chapter~\thechapter}{0pt}{}
}{
  \titleformat{\chapter}[display]{\LARGE\sffamily\bfseries}{第\,\thechapter\,章}{0pt}{}
}
\ExplSyntaxOff

\titleformat{\section}{\Large\sffamily\bfseries}{\thesection}{12pt}{}
\titleformat{\subsection}{\large\sffamily\bfseries}{\thesubsection}{12pt}{}

\renewcommand{\thesection}{\arabic{chapter}.\arabic{section}}
\renewcommand{\thesubsection}{\arabic{chapter}.\arabic{section}.\arabic{subsection}}
\renewcommand{\theequation}{\arabic{chapter}.\arabic{equation}}
\renewcommand{\thefigure}{\arabic{chapter}.\arabic{figure}}
\renewcommand{\thetable}{\arabic{chapter}.\arabic{table}}

% ------------------------------------------------------------------------------
% 日本語表記
% ------------------------------------------------------------------------------
\ExplSyntaxOn
\tl_new:N \l_abstract_name_tl
\tl_new:N \l_chapabst_name_tl
\tl_new:N \l_ack_name_tl
\tl_new:N \l_appendix_name_tl

\bool_if:nTF {\l_thesis_english_bool}{
  \tl_set:Nn \l_abstract_name_tl {Abstract}
  \tl_set:Nn \l_chapabst_name_tl {Chapter summary}
  \tl_set:Nn \l_ack_name_tl {Acknowledgment}
  \tl_set:Nn \l_appendix_name_tl {Appendix}
  \NewDocumentCommand{\biblioname}{}{References}
}{
  \tl_set:Nn \l_abstract_name_tl {概要}
  \tl_set:Nn \l_chapabst_name_tl {本章の概要}
  \tl_set:Nn \l_ack_name_tl {謝辞}
  \tl_set:Nn \l_appendix_name_tl {付録}
  \NewDocumentCommand{\biblioname}{}{参考文献}

  \RenewDocumentCommand{\figurename}{}{図}
  \RenewDocumentCommand{\tablename}{}{表}
  \RenewDocumentCommand{\contentsname}{}{目次}
  \RenewDocumentCommand{\listfigurename}{}{図目次}
  \RenewDocumentCommand{\listtablename}{}{表目次}
  \RenewDocumentCommand{\appendixtocname}{}{付録}
}
\ExplSyntaxOff

% ------------------------------------------------------------------------------
% 表紙の設定
% ------------------------------------------------------------------------------

% 表紙用の新変数
\def\thesistype#1{\gdef\@thesistype{#1}}
\def\title#1{\gdef\@title{#1}}
\def\etitle#1{\gdef\@etitle{#1}}
\def\author#1{\gdef\@author{#1}}
\def\eauthor#1{\gdef\@eauthor{#1}}
\def\affiliation#1{\gdef\@affiliation{#1}}
\def\eaffiliation#1{\gdef\@eaffiliation{#1}}
\def\edate#1{\gdef\@edate{#1}}

\ExplSyntaxOn
  \tl_new:N \g_thesis_type_tl
  \tl_new:N \g_thesis_title_tl
  \tl_new:N \g_thesis_author_tl
  \tl_new:N \g_thesis_etitle_tl
  \tl_new:N \g_thesis_eauthor_tl
  \tl_new:N \g_thesis_affiliation_tl
  \tl_new:N \g_thesis_eaffiliation_tl
  \tl_new:N \g_thesis_edate_tl
  \dim_new:N \g_thesis_adjustspace_dim

  \tl_gset:Nn \g_thesis_type_tl {\@thesistype}
  \tl_gset:Nn \g_thesis_title_tl {\@title}
  \tl_gset:Nn \g_thesis_author_tl {\@author}
  \tl_gset:Nn \g_thesis_etitle_tl {\@etitle}
  \tl_gset:Nn \g_thesis_eauthor_tl {\@eauthor}
  \tl_gset:Nn \g_thesis_affiliation_tl {\@affiliation}
  \tl_gset:Nn \g_thesis_eaffiliation_tl {\@eaffiliation}
  \tl_gset:Nn \g_thesis_edate_tl {\@edate}
  \NewDocumentCommand{\adjustspace}{m}{
    \dim_gset:Nn \g_thesis_adjustspace_dim {#1}
  }
\ExplSyntaxOff

\ExplSyntaxOn
  \dim_new:N \l_type_to_title_sep_dim
  \dim_new:N \l_title_to_author_sep_dim
  \dim_new:N \l_author_to_affiliation_sep_dim
  \dim_new:N \l_affiliation_to_date_sep_dim
  \dim_new:N \l_before_logo_sep_dim

  \bool_if:nTF {\l_thesis_english_bool}{
    \dim_set:Nn \l_type_to_title_sep_dim {22pt}
    \dim_set:Nn \l_title_to_author_sep_dim {44pt}
    \dim_set:Nn \l_author_to_affiliation_sep_dim {11pt}
    \dim_set:Nn \l_affiliation_to_date_sep_dim {22pt}
  }{
    \dim_set:Nn \l_type_to_title_sep_dim {88pt}
    \dim_set:Nn \l_title_to_author_sep_dim {154pt}
    \dim_set:Nn \l_author_to_affiliation_sep_dim {22pt}
    \dim_set:Nn \l_affiliation_to_date_sep_dim {44pt}
  }

  \bool_if:nTF {\l_thesis_nologo_bool}{
    \dim_set:Nn \l_before_logo_sep_dim {0pt}
  }{
    \dim_set:Nn \l_before_logo_sep_dim {22pt}
  }

  \dim_new:N \l_content_height_dim
  \dim_set:Nn \l_content_height_dim {
    132pt
    + \l_type_to_title_sep_dim
    + \l_title_to_author_sep_dim
    + \l_author_to_affiliation_sep_dim
    + \l_affiliation_to_date_sep_dim
    + \l_before_logo_sep_dim
  }

  \bool_if:nTF {\l_thesis_english_bool}{
    \dim_set:Nn \l_content_height_dim {2 \l_content_height_dim}
  }{
    \dim_set:Nn \l_content_height_dim {\l_content_height_dim}
  }

  \dim_new:N \l_title_page_top_sep_dim
  \dim_set:Nn \l_title_page_top_sep_dim { (\l_text_height_dim - \l_content_height_dim) / 2 }
\ExplSyntaxOff

% 表紙に使うレイアウトの定義
\definecolor{CoverRuleColor}{rgb}{0.4, 0.4, 0.4}
\RequirePackage{fbox}
\def\coverpagebox{\VerbBox\@coverpagebox}
\def\@coverpagebox#1{%
  \begingroup
    \setbox\@fancybox\hbox{{#1}}%
    \fboxrule=2.0\fboxrule
    \fboxsep=\fboxrule
    \advance\fboxsep 2pt
    \fbox[lcolor=CoverRuleColor,rcolor=CoverRuleColor,tcolor=CoverRuleColor,bcolor=CoverRuleColor]{\box\@fancybox}
  \endgroup
}

% 表紙コマンドの定義
\ExplSyntaxOn
\cs_new_protected:Npn \thesis_make_title: {
  % 日本語タイトル
  \vspace*{\dim_use:N \l_title_page_top_sep_dim}
  {\bfseries\sffamily\Large {\tl_use:N \g_thesis_type_tl}}\\
  \vspace*{\dim_use:N \l_type_to_title_sep_dim}
  {\bfseries\sffamily\LARGE {\tl_use:N \g_thesis_title_tl}}\\
  \vspace*{\dim_use:N \l_title_to_author_sep_dim}
  {\Large	{\tl_use:N \g_thesis_author_tl}} \\
  \vspace*{\dim_use:N \l_author_to_affiliation_sep_dim}
  {\Large {\tl_use:N \g_thesis_affiliation_tl}}\\
  \vspace*{\dim_use:N \l_affiliation_to_date_sep_dim}
  {\Large {\tl_use:N \g_thesis_edate_tl}} \\
  % 英語タイトル
  \bool_if:NTF {\l_thesis_english_bool}{
    \vspace*{\dim_use:N \g_thesis_adjustspace_dim}
    {\rmfamily\LARGE {\tl_use:N \g_thesis_etitle_tl}}\\
    \vspace*{\dim_use:N \l_title_to_author_sep_dim}
    {\Large	{\tl_use:N \g_thesis_eauthor_tl}} \\
    \vspace*{\dim_use:N \l_author_to_affiliation_sep_dim}
    {\Large {\tl_use:N \g_thesis_eaffiliation_tl}}\\
    \vspace*{\dim_use:N \l_affiliation_to_date_sep_dim}
    {\Large {\tl_use:N \g_thesis_edate_tl}} \\
  }{}
  % ロゴの表示
  \vspace*{\dim_use:N \l_before_logo_sep_dim}
  \bool_if:NTF {\l_thesis_nologo_bool}{
  }{
    \hspace{5truemm}
    \includegraphics[height=18truemm]{logo.pdf}
    \hspace{5truemm}
    \raisebox{1truemm}{\includegraphics[height=16truemm]{sds.pdf}}
  }
}
\ExplSyntaxOff

\renewcommand{\maketitle}{
	\thispagestyle{empty}
  \fancypage{\coverpagebox}{}
  \begin{center}
  {\expandafter\csname thesis_make_title:\endcsname}
  \vfill
  \end{center}
	\newpage
	\fancypage{}{}
	\cleardoublepage
}

% ------------------------------------------------------------------------------
% 目次の設定
% ------------------------------------------------------------------------------

% 番号とタイトルの間のスペースを調整
\RequirePackage{tocloft}
\setlength\cftfignumwidth{3em}
\setlength\cfttabnumwidth{3em}

% 目次のフォントを設定
\RenewDocumentCommand{\cfttoctitlefont}{}{\LARGE\bfseries\sffamily}
\RenewDocumentCommand{\cftloftitlefont}{}{\LARGE\bfseries\sffamily}
\RenewDocumentCommand{\cftlottitlefont}{}{\LARGE\bfseries\sffamily}
\RenewDocumentCommand{\cftchapfont}{}{\large\sffamily\bfseries}
\RenewDocumentCommand{\cftsecfont}{}{\normalsize}
\RenewDocumentCommand{\cftsubsecfont}{}{\normalsize}

% 章の項目もドットでページ番号までを繋ぐ
%\renewcommand{\cftchapleader}{\cftdotfill{\cftchapdotsep}}
%\renewcommand{\cftchapdotsep}{\cftdotsep}
\renewcommand{\cftdotsep}{0.5}

% ------------------------------------------------------------------------------
% 論文全体の概要
% ------------------------------------------------------------------------------
\ExplSyntaxOn
\cs_new_protected:Npn \thesis_setup_abstract_title: {
  {\bfseries\sffamily\large {\tl_use:N \l_abstract_name_tl}}
}
\ExplSyntaxOff

\NewDocumentEnvironment{abstract}{}{%
  \thispagestyle{empty}
  \vspace*{40truemm}
  \begin{center}
  {\expandafter\csname thesis_setup_abstract_title:\endcsname}
  \end{center}
  \edef\currentindent{\the\parindent}
  \begin{minipage}{\textwidth}\setlength{\parindent}{\currentindent}
}{%
  \end{minipage}
  \clearpage
}

% ------------------------------------------------------------------------------
% 各章の概要
% ------------------------------------------------------------------------------
\NewDocumentCommand{\textitjp}{m}{%
  \makebox[2.25zw][l]{%
    \vphantom{#1}\rotatebox{-48.8}{
      \scalebox{0.875}[1.143]{
        \rotatebox{41.2}{
          \smash{\rlap{#1}}
        }
      }
    }
  }
}

\ExplSyntaxOn
  \dim_new:N \l_chapabst_below_skip_dim
  \dim_set:Nn \l_chapabst_below_skip_dim {5mm}
  \NewDocumentEnvironment{chapabst}{}{%
    \setlength\rightskip{1in}%
    \begin{small}\noindent\textbf{\textsf{\tl_use:N \l_chapabst_name_tl :}}~
  }{%
    \end{small}\vspace{\dim_use:N \l_chapabst_below_skip_dim}
  }
\ExplSyntaxOff

% ------------------------------------------------------------------------------
% ページヘッダの制御
% ------------------------------------------------------------------------------

% ヘッダの下の横線
\pagestyle{fancyplain}

% ヘッダの内容
\fancyhead{}
\fancyhead[RO,RE]{\rightmark}
\fancyhead[LE,LO]{\leftmark}
\fancyhead[RE]{\gdef\headrulewidth{.4pt}}
\fancyhead[LO]{\gdef\headrulewidth{.4pt}}
\fancyfoot[C]{--\,\thepage\,--}

%ヘッダ記述。 ~ で章・節番号とそのタイトルの間のスペースを調整
\ExplSyntaxOn
\bool_if:nTF {\l_thesis_english_bool}{
}{
  \RenewDocumentCommand{\chaptermark}{m}{\markboth{第\,\thechapter\,章\quad #1}{}}
  \RenewDocumentCommand{\sectionmark}{m}{\markright{\thesection\quad #1}{}}
  \AtBeginEnvironment{appendices}{%
    \RenewDocumentCommand{\chaptermark}{m}{\markboth{付録\,\thechapter\quad #1}{}}
  }
}
\ExplSyntaxOff

% plainスタイルを再定義してheaderが章の最初の出ないようにする
% https://tex.stackexchange.com/questions/117328/fancyhdr-does-not-apply-same-header-footer-on-chapter-and-non-chapter-pages
\fancypagestyle{plain}{%
  \fancyhead{}%
  \renewcommand{\headrulewidth}{0pt}% Line at the header invisible
}

% ------------------------------------------------------------------------------
% 参考文献が目次に載るようにする。
% http://www.nsknet.or.jp/~tony/TeX/faq/macro.htm
% ------------------------------------------------------------------------------
\RenewDocumentEnvironment{thebibliography}{m}{% 再定義
  \chapter*{\biblioname\@mkboth{\biblioname}{\biblioname}}%
  \addcontentsline{toc}{chapter}{\biblioname}% この行追加
  \list{\@biblabel{\@arabic\c@enumiv}}%
    {\settowidth\labelwidth{\@biblabel{#1}}%
      \leftmargin\labelwidth
      \advance\leftmargin\labelsep
      \@openbib@code
      \usecounter{enumiv}%
      \let\p@enumiv\@empty
      \renewcommand\theenumiv{\@arabic\c@enumiv}}%
  \sloppy
  \clubpenalty4000
  \@clubpenalty\clubpenalty
  \widowpenalty4000%
  \sfcode`\.\@m
}{%
  \def\@noitemerr%
    {\@latex@warning{Empty `thebibliography' environment}}%
  \endlist
}

% ------------------------------------------------------------------------------
%謝辞
% ------------------------------------------------------------------------------
\ExplSyntaxOn
\cs_new_protected:Npn \thesis_setup_acks: {
  \RenewDocumentCommand{\chaptermark}{m}{
    \markboth{\tl_use:N \l_ack_name_tl}{}
  }
  \chapter*{\tl_use:N \l_ack_name_tl}
  \addcontentsline{toc}{chapter}{\tl_use:N \l_ack_name_tl}
}
\ExplSyntaxOff
\NewDocumentEnvironment{acks}{}{\csname thesis_setup_acks:\endcsname}{}

% ------------------------------------------------------------------------------
% 目次の設定
% ------------------------------------------------------------------------------
% 目次に乗せる項目を\subsection まで索引を作成する。
\setcounter{tocdepth}{2}

% ------------------------------------------------------------------------------
% 数式前後のマージンの設定
% ------------------------------------------------------------------------------
\AtBeginDocument{\setlength{\abovedisplayskip}{8mm}}
\AtBeginDocument{\setlength{\abovedisplayshortskip}{8mm}}
\AtBeginDocument{\setlength{\belowdisplayskip}{8mm}}
\AtBeginDocument{\setlength{\belowdisplayshortskip}{8mm}}
\NewDocumentCommand{\adjustdisplayskips}{m}{%
  \setlength{\abovedisplayskip}{#1}
  \setlength{\abovedisplayshortskip}{#1}
  \setlength{\belowdisplayskip}{#1}
  \setlength{\belowdisplayshortskip}{#1}
}

% ------------------------------------------------------------------------------
% 箇条書きの設定
% ------------------------------------------------------------------------------
\RequirePackage{enumitem}
\setlist{
  itemsep=1pt,
  parsep=0pt,
  labelsep=3mm
}

\setlist[itemize]{
  label=$\vcenter{\hbox{$\bullet$}}$,
}

\setlist[enumerate]{
  label={\bfseries\sffamily\arabic*.}
}

% ------------------------------------------------------------------------------
% 図表の設定
% ------------------------------------------------------------------------------
\RequirePackage{caption}
\captionsetup[figure]{format=plain, labelformat=simple, labelsep=quad, labelfont={bf,sf}, font=small, justification=justified}
\captionsetup[table]{format=plain, labelformat=simple, labelsep=quad, labelfont={bf,sf}, font=small, justification=justified}
\captionsetup[lstlisting]{format=plain, labelformat=simple, labelsep=quad, labelfont={bf,sf}, font=small, justification=justified}

\RequirePackage{floatrow}
\floatsetup[figure]{capposition=bottom}
\floatsetup[table]{capposition=top}
\floatsetup[lstlisting]{capposition=top}

% ------------------------------------------------------------------------------
% ソースコードの設定
% ------------------------------------------------------------------------------
\RequirePackage{listings}
\RequirePackage{jvlisting}

\ExplSyntaxOn
  \bool_if:NTF {\l_thesis_english_bool}{
    \RenewDocumentCommand{\lstlistingname}{}{Listing}
  }{
    \RenewDocumentCommand{\lstlistingname}{}{リスト}
  }
\ExplSyntaxOff

\lstset{
  basicstyle=\ttfamily\footnotesize,
  commentstyle=\textit,
  classoffset=1,
  keywordstyle=\bfseries,
  frame=trbl,
  framesep=5pt,
  xrightmargin=0pt,
  xleftmargin=5pt,
  showstringspaces=false,
  columns=[l]{fullflexible},
  stepnumber=1,
  numberstyle=\footnotesize,
  tabsize=2,
  breaklines=true,
}

% ------------------------------------------------------------------------------
% 枠付き段落
% ------------------------------------------------------------------------------
\RequirePackage{color}
\RequirePackage{mdframed}
\NewDocumentEnvironment{titlebox}{m}{%
  \mdfsetup{
    frametitle={\colorbox{white}{\space#1\space}},
    innertopmargin=0,
    frametitleaboveskip=-.8\ht\strutbox,
    frametitlealignment=\raggedright
  }
  \begin{mdframed}
}{%
  \end{mdframed}
}

% ------------------------------------------------------------------------------
% リンクの設定
% ------------------------------------------------------------------------------
\definecolor{LinkColor}{rgb}{0.2,0.5,1.0}
\AtEndPreamble{
  \ifluatex
    \RequirePackage[luatex,pdfa=true]{hyperref}
  \fi
  \ifxetex
    \RequirePackage[xetex,pdfa=true]{hyperref}
  \fi
  \RequirePackage{hyperxmp}
  \hypersetup{
    pdfencoding=auto,
    pdfapart=3,
    pdfaconformance=u,
    backref=true,
    bookmarks=true,
    bookmarksnumbered=true,
    bookmarksopen=true,
    colorlinks=true,
    linktocpage=true,         % 目次においてページ番号にリンクをつける
    linkcolor=RoyalBlue,      % 主に章や節の番号のリンク
    citecolor=RoyalBlue,      % 文献の引用
    urlcolor=Magenta,         % URL
  }
}

% ***** CleverRefの設定 *****
\ExplSyntaxOn
\cs_new_protected:Npn \cref_format_jp:nnn #1#2#3 {
  \crefformat{#1}{##2#2\,##1\,#3##3}%
  \crefrangeformat{#1}{##3#2\,##1\,#3##4から##5#2\,##2\,#3##6}%
