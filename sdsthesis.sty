% ------------------------------------------------------------------------------
% 付録の設定
% ------------------------------------------------------------------------------
\NewCommandCopy\oldappendices\appendices
\NewCommandCopy\endoldappendices\endappendices

\ExplSyntaxOn

\RenewDocumentEnvironment{appendices}{}{%
  \begin{oldappendices}
  \noappendicestocpagenum
  \addappheadtotoc
  \renewcommand{\thechapter}{\Alph{chapter}}
  \titleformat{\chapter}[display]{\LARGE\bfseries\sffamily}{{\tl_use:N \l__sdsthesis_appendix_name_tl}\space\thechapter}{0pt}{}
}{%
  \end{oldappendices}
}

\ExplSyntaxOff

\renewcommand{\@redotocentry@pp}[1]{%
  \NewCommandCopy\oldacl@pp\addcontentsline
  \def\addcontentsline##1##2##3{%
    \def\@pptempa{##1}\def\@pptempb{toc}%
    \ifx\@pptempa\@pptempb
      \def\@pptempa{##2}\def\@pptempb{#1}%
      \ifx\@pptempa\@pptempb
        \oldacl@pp{##1}{##2}{\@appendixname\space ##3}%
      \else
        \oldacl@pp{##1}{##2}{\chaptertitlename\space ##3}% added \chaptertitlename
      \fi
    \else
      \oldacl@pp{##1}{##2}{##3}%
    \fi
  }
}

% cleveref assigns appendix/subappendix types via \appendix; keep the
% main-text chapter/section formats unchanged for references from appendices.
% Recent LaTeX kernels (first aid for cleveref, 2024-10 and later) recompute
% the label type from the raw counter name in the `label' hook, which bypasses
% cleveref's \appendix hook, so the aliases are also declared explicitly.
\AddToHook{env/appendices/begin}{
  \pagestyle{plain}
  \appendix
  \crefalias{chapter}{appendix}
  \crefalias{section}{subappendix}
  \crefalias{subsection}{subsubappendix}
  \crefalias{subsubsection}{subsubsubappendix}
}

