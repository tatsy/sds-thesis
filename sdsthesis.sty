% sdsthesis.sty
\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{sdsthesis}[2026-09-15 SDS thesis style]

% ------------------------------------------------------------------------------
% スタイルファイルオプションの設定
% ------------------------------------------------------------------------------

\ExplSyntaxOn

% 言語設定のオプション
\bool_new:N \l__sdsthesis_english_bool

% ロゴの表示のオプション
\bool_new:N \l__sdsthesis_nologo_bool

% 句読点のオプション (comma: 「，」「．」に統一, kuten: 「、」「。」に統一)
\tl_new:N \l__sdsthesis_punctuation_tl

% PDF/Aのメタデータを埋め込むオプション (既定は無効)
\bool_new:N \l__sdsthesis_pdfa_bool

% エラー・警告メッセージの定義
\msg_new:nnn {sdsthesis}{unknown-option}
  {Unknown~option~`#1'~ignored.}
\msg_new:nnn {sdsthesis}{unsupported-engine}
  {Only~LuaTeX~and~XeTeX~are~supported.}

% オプションの処理
\keys_define:nn {sdsthesis}{
  english .bool_set:N = \l__sdsthesis_english_bool,
  nologo .bool_set:N = \l__sdsthesis_nologo_bool,
  pdfa .bool_set:N = \l__sdsthesis_pdfa_bool,
  punctuation .choices:nn =
    {comma, kuten}
    { 
      \tl_set:NV
        \l__sdsthesis_punctuation_tl
        \l_keys_choice_tl
    },
  punctuation .initial:n = comma,
  punctuation .value_required:n = true,
  unknown .code:n = {
    \msg_warning:nnn {sdsthesis}{unknown-option}{\l_keys_key_str}
  },
}
\ProcessKeyOptions[ sdsthesis ]

% LuaTeXかXeTeXのみをサポート
\sys_if_engine_luatex:F
{
  \sys_if_engine_xetex:F
  {
    \msg_fatal:nn{sdsthesis}{unsupported-engine}
  }
}

\ExplSyntaxOff

% ------------------------------------------------------------------------------
% 必要なパッケージ
% ------------------------------------------------------------------------------
\RequirePackage{mathtools}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage[svgnames,dvipsnames,x11names]{xcolor}
\RequirePackage[pagestyles]{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{fancybox}
\RequirePackage{emptypage}
\RequirePackage{xspace}
\RequirePackage[title]{appendix}
\RequirePackage{graphicx}

% ------------------------------------------------------------------------------
% フォントの設定
% ------------------------------------------------------------------------------

% LuaTeX/XeTeX用の設定
\ExplSyntaxOn
\sys_if_engine_luatex:TF
  {
    % LuaTeX
    \RequirePackage[no-math]{luatexja}
    \RequirePackage[haranoaji]{luatexja-preset}
  }
  {
    % XeTeX
    \RequirePackage{fontspec}
    \RequirePackage{zxjatype}
    \RequirePackage[haranoaji]{zxjafont}
    \newlength{\zw}
    \setlength{\zw}{1em}
    \newlength{\zh}
    \setlength{\zh}{1.1\zw}
  }
\ExplSyntaxOff

% ------------------------------------------------------------------------------
% 英文・数式フォントの設定
% ------------------------------------------------------------------------------

% mathrm=sym: \mathrmはテキストフォントではなく数式フォントを使う。
% テキストフォントには数式用のギリシャ文字がないため、標準設定のままだと
% \mathrm{\mu m}のようなギリシャ文字が出力されなくなる。
\RequirePackage[math-style=TeX,bold-style=TeX,mathrm=sym]{unicode-math}
\setmainfont{STIX Two Text}[Scale=1.0]
\setmathfont{STIX Two Math}[Scale=1.0]
\setsansfont{Roboto}[Scale=1.0, BoldFont=Roboto Medium, ItalicFont=Roboto Italic, BoldItalicFont=Roboto Medium Italic]

% \mathbf, \mathitはunicode-mathの標準定義をそのまま使う。
% ボールドイタリックが必要な場合はunicode-mathの\symbfitを使う。

% 数式の下付き・上付き文字のサイズを調整
\RequirePackage{latexsym}
\DeclareMathSizes{10}{10}{7}{7}
\DeclareMathSizes{10.5}{11}{7}{7} % For size 10 text
\DeclareMathSizes{11}{12}{6.5}{6.5} % For size 11 text
\DeclareMathSizes{12}{13}{7}{7} % For size 12 text

% ------------------------------------------------------------------------------
% 句読点の自動置換
% ------------------------------------------------------------------------------
\RequirePackage{newunicodechar}
\ExplSyntaxOn
\str_if_eq:VnTF \l__sdsthesis_punctuation_tl {kuten}{
  % 「、」「。」に統一する
  \newunicodechar{，}{、}
  \newunicodechar{．}{。}
}{
  % 「，」「．」に統一する (既定)
  \newunicodechar{、}{，}
  \newunicodechar{。}{．}
}
\ExplSyntaxOff
\newunicodechar{⭕}{\raisebox{.2ex}{$\bigcirc$}}
\newunicodechar{○}{\raisebox{.2ex}{$\bigcirc$}}
\newunicodechar{◯}{\raisebox{.2ex}{$\bigcirc$}}
\newunicodechar{☓}{$\times$}

% ------------------------------------------------------------------------------
% SI単位系の表示を調整
% ------------------------------------------------------------------------------
\RequirePackage{siunitx}
\sisetup{
  group-separator={,},
}

% ------------------------------------------------------------------------------
% ページの設定
% ------------------------------------------------------------------------------
% 1inch = 25.4 mm
% A4 210mm×297mm
\RequirePackage{geometry}
\ExplSyntaxOn
  % ページの幅と高さ
  \dim_const:Nn \c__sdsthesis_text_width_dim {160mm}
  \dim_const:Nn \c__sdsthesis_text_height_dim {224mm}
  \dim_const:Nn \c__sdsthesis_left_margin_dim {24mm}
  \dim_const:Nn \c__sdsthesis_head_height_dim {5mm}
  \geometry{
    textwidth={\dim_use:N \c__sdsthesis_text_width_dim},
    textheight={\dim_use:N \c__sdsthesis_text_height_dim},
    left={\dim_use:N \c__sdsthesis_left_margin_dim},
    headheight={\dim_use:N \c__sdsthesis_head_height_dim},
  }
\ExplSyntaxOff

% ページのコンテンツを上に詰める
\raggedbottom

% ------------------------------------------------------------------------------
% 各種サイズ
% ------------------------------------------------------------------------------
\ExplSyntaxOn
\bool_if:NF \l__sdsthesis_english_bool {
  \RequirePackage{indentfirst}
  \setlength{\parindent}{1\zw}
  \renewcommand{\baselinestretch}{1.2}
}
\ExplSyntaxOff

% ------------------------------------------------------------------------------
% 章，節などの設定
% ------------------------------------------------------------------------------
\ExplSyntaxOn
\bool_if:NTF \l__sdsthesis_english_bool{
  \titleformat{\chapter}[display]{\LARGE\sffamily\bfseries}{Chapter~\thechapter}{0pt}{}
}{
  \titleformat{\chapter}[display]{\LARGE\sffamily\bfseries}{第\,\thechapter\,章}{0pt}{}
}
\ExplSyntaxOff

\titleformat{\section}{\Large\sffamily\bfseries}{\thesection}{12pt}{}
\titleformat{\subsection}{\large\sffamily\bfseries}{\thesubsection}{12pt}{}

\renewcommand{\thesection}{\thechapter.\arabic{section}}
\renewcommand{\thesubsection}{\thechapter.\arabic{section}.\arabic{subsection}}
\renewcommand{\theequation}{\thechapter.\arabic{equation}}
\renewcommand{\thefigure}{\thechapter.\arabic{figure}}
\renewcommand{\thetable}{\thechapter.\arabic{table}}

% ------------------------------------------------------------------------------
% 日本語表記
% ------------------------------------------------------------------------------
\ExplSyntaxOn

\tl_new:N \l__sdsthesis_abstract_name_tl
\tl_new:N \l__sdsthesis_chapabst_name_tl
\tl_new:N \l__sdsthesis_ack_name_tl
\tl_new:N \l__sdsthesis_appendix_name_tl

\bool_if:NTF \l__sdsthesis_english_bool{
  \tl_set:Nn \l__sdsthesis_abstract_name_tl {Abstract}
  \tl_set:Nn \l__sdsthesis_chapabst_name_tl {Chapter~summary}
  \tl_set:Nn \l__sdsthesis_ack_name_tl {Acknowledgment}
  \tl_set:Nn \l__sdsthesis_appendix_name_tl {Appendix}
  \newcommand{\biblioname}{References}
}{
  \tl_set:Nn \l__sdsthesis_abstract_name_tl {概要}
  \tl_set:Nn \l__sdsthesis_chapabst_name_tl {本章の概要}
  \tl_set:Nn \l__sdsthesis_ack_name_tl {謝辞}
  \tl_set:Nn \l__sdsthesis_appendix_name_tl {付録}
  \newcommand{\biblioname}{参考文献}

  \RenewDocumentCommand{\figurename}{}{図}
  \RenewDocumentCommand{\tablename}{}{表}
  \RenewDocumentCommand{\contentsname}{}{目次}
  \RenewDocumentCommand{\listfigurename}{}{図目次}
  \RenewDocumentCommand{\listtablename}{}{表目次}
  \RenewDocumentCommand{\appendixtocname}{}{付録}
}
\ExplSyntaxOff

% ------------------------------------------------------------------------------
% 表紙の設定
% ------------------------------------------------------------------------------

% 表紙用の新変数
\ExplSyntaxOn

\tl_new:N \g__sdsthesis_type_tl
\tl_new:N \g__sdsthesis_etitle_tl
\tl_new:N \g__sdsthesis_eauthor_tl
\tl_new:N \g__sdsthesis_affiliation_tl
\tl_new:N \g__sdsthesis_eaffiliation_tl
\tl_new:N \g__sdsthesis_edate_tl

\dim_new:N \g__sdsthesis_adjustspace_dim

\NewDocumentCommand{\thesistype}{m}{
  \tl_gset:Nn \g__sdsthesis_type_tl {#1}
}

\NewDocumentCommand{\etitle}{m}{
  \tl_gset:Nn \g__sdsthesis_etitle_tl {#1}
}

\NewDocumentCommand{\eauthor}{m}{
  \tl_gset:Nn \g__sdsthesis_eauthor_tl {#1}
}

\NewDocumentCommand{\affiliation}{m}{
  \tl_gset:Nn \g__sdsthesis_affiliation_tl {#1}
}

\NewDocumentCommand{\eaffiliation}{m}{
  \tl_gset:Nn \g__sdsthesis_eaffiliation_tl {#1}
}

\NewDocumentCommand{\edate}{m}{
  \tl_gset:Nn \g__sdsthesis_edate_tl {#1}
}

\NewDocumentCommand{\adjustspace}{m}{
  \dim_gset:Nn \g__sdsthesis_adjustspace_dim {#1}
}

\ExplSyntaxOff

\ExplSyntaxOn
  \dim_new:N \l__sdsthesis_type_to_title_sep_dim
  \dim_new:N \l__sdsthesis_title_to_author_sep_dim
  \dim_new:N \l__sdsthesis_author_to_affiliation_sep_dim
  \dim_new:N \l__sdsthesis_affiliation_to_date_sep_dim
  \dim_new:N \l__sdsthesis_before_logo_sep_dim

  \bool_if:NTF \l__sdsthesis_english_bool{
    \dim_set:Nn \l__sdsthesis_type_to_title_sep_dim {22pt}
    \dim_set:Nn \l__sdsthesis_title_to_author_sep_dim {44pt}
    \dim_set:Nn \l__sdsthesis_author_to_affiliation_sep_dim {11pt}
    \dim_set:Nn \l__sdsthesis_affiliation_to_date_sep_dim {22pt}
  }{
    \dim_set:Nn \l__sdsthesis_type_to_title_sep_dim {88pt}
    \dim_set:Nn \l__sdsthesis_title_to_author_sep_dim {154pt}
    \dim_set:Nn \l__sdsthesis_author_to_affiliation_sep_dim {22pt}
    \dim_set:Nn \l__sdsthesis_affiliation_to_date_sep_dim {44pt}
  }

  \bool_if:NTF \l__sdsthesis_nologo_bool{
    \dim_set:Nn \l__sdsthesis_before_logo_sep_dim {0pt}
  }{
    \dim_set:Nn \l__sdsthesis_before_logo_sep_dim {22pt}
  }

  \dim_new:N \l__sdsthesis_content_height_dim 
  \dim_set:Nn \l__sdsthesis_content_height_dim {
    132pt
    + \l__sdsthesis_type_to_title_sep_dim
    + \l__sdsthesis_title_to_author_sep_dim
    + \l__sdsthesis_author_to_affiliation_sep_dim
    + \l__sdsthesis_affiliation_to_date_sep_dim
    + \l__sdsthesis_before_logo_sep_dim
  }

  \bool_if:NT \l__sdsthesis_english_bool{
    \dim_set:Nn \l__sdsthesis_content_height_dim {2 \l__sdsthesis_content_height_dim}
  }

  \dim_new:N \l__sdsthesis_title_page_top_sep_dim
  \dim_set:Nn \l__sdsthesis_title_page_top_sep_dim { 
    (\c__sdsthesis_text_height_dim - \l__sdsthesis_content_height_dim) / 2
  }
\ExplSyntaxOff

% 表紙に使うレイアウトの定義
\definecolor{CoverRuleColor}{rgb}{0.4, 0.4, 0.4}
\RequirePackage{fbox}
\def\coverpagebox{\VerbBox\@coverpagebox}
\def\@coverpagebox#1{%
  \begingroup
    \setbox\@fancybox\hbox{{#1}}%
    \fboxrule=2.0\fboxrule
    \fboxsep=\fboxrule
    \advance\fboxsep 2pt
    \fbox[lcolor=CoverRuleColor,rcolor=CoverRuleColor,tcolor=CoverRuleColor,bcolor=CoverRuleColor]{\box\@fancybox}
  \endgroup
}

% PDFのメタデータ (題目・著者)を表紙の情報から設定
\ExplSyntaxOn
\cs_new_protected:Npn
  \__sdsthesis_set_pdf_metadata:
  {
    \bool_if:NTF
      \l__sdsthesis_english_bool
      {
        \hypersetup
          {
            pdftitle =
              { \tl_use:N \g__sdsthesis_etitle_tl },
            pdfauthor =
              { \tl_use:N \g__sdsthesis_eauthor_tl },
          }
      }
      {
        \hypersetup
          {
            pdftitle = { \@title },
            pdfauthor = { \@author },
          }
      }
  }
\ExplSyntaxOff

% 表紙コマンドの定義
\ExplSyntaxOn
\cs_new_protected:Npn \__sdsthesis_make_title: {
  % 日本語タイトル
  \vspace*{\dim_use:N \l__sdsthesis_title_page_top_sep_dim}
  {
    \bfseries\sffamily\Large
    \tl_use:N \g__sdsthesis_type_tl
  }
  \\

  \vspace*{\dim_use:N \l__sdsthesis_type_to_title_sep_dim}
  {
    \bfseries\sffamily\LARGE
    \@title
  }
  \\

  \vspace*{\dim_use:N \l__sdsthesis_title_to_author_sep_dim}
  {
    \Large
    \@author
  }
  \\
  
  \vspace*{\dim_use:N \l__sdsthesis_author_to_affiliation_sep_dim}
  {
    \Large
    {\tl_use:N \g__sdsthesis_affiliation_tl}
  }
  \\

  \vspace*{\dim_use:N \l__sdsthesis_affiliation_to_date_sep_dim}
  {
    \Large
    \@date
  }
  \\

  % 英語タイトル
  \bool_if:NT \l__sdsthesis_english_bool{
    \vspace*{\dim_use:N \g__sdsthesis_adjustspace_dim}
    {
      \rmfamily\LARGE
      \tl_use:N \g__sdsthesis_etitle_tl
    }
    \\

    \vspace*{\dim_use:N \l__sdsthesis_title_to_author_sep_dim}
    {
      \Large
      \tl_use:N \g__sdsthesis_eauthor_tl
    }
    \\

    \vspace*{\dim_use:N \l__sdsthesis_author_to_affiliation_sep_dim}
    {
      \Large
      \tl_use:N \g__sdsthesis_eaffiliation_tl
    }
    \\

    \vspace*{\dim_use:N \l__sdsthesis_affiliation_to_date_sep_dim}
    {
      \Large
      \tl_use:N \g__sdsthesis_edate_tl
    }
    \\
  }

  % ロゴの表示
  \vspace*{\dim_use:N \l__sdsthesis_before_logo_sep_dim}

  \bool_if:NF \l__sdsthesis_nologo_bool {
    \hspace{5truemm}
    \includegraphics[height=18truemm]{logo.pdf}
    \hspace{5truemm}
    \raisebox{1truemm}{\includegraphics[height=16truemm]{sds.pdf}}
  }
}
\ExplSyntaxOff

% hyperxmp (pdfaオプション)は\begin{document}の時点で著者情報を確定するため、
% プリアンブルで表紙の情報が与えられていれば文書の開始時にメタデータを設定し、
% \maketitleでも改めて設定する。
\ExplSyntaxOn

\AtBeginDocument{
  \__sdsthesis_set_pdf_metadata:
}

\RenewDocumentCommand{\maketitle}{}{
  \__sdsthesis_set_pdf_metadata:

  \thispagestyle{empty}
  \fancypage{\coverpagebox}{}

  \begin{center}
    \__sdsthesis_make_title:
    \vfill
  \end{center}
	
  \newpage
	\fancypage{}{}
	\cleardoublepage
}

\ExplSyntaxOff

% ------------------------------------------------------------------------------
% 目次の設定
% ------------------------------------------------------------------------------

% 番号とタイトルの間のスペースを調整
\RequirePackage{tocloft}
\setlength\cftfignumwidth{3em}
\setlength\cfttabnumwidth{3em}

% 目次のフォントを設定
\RenewDocumentCommand{\cfttoctitlefont}{}{\LARGE\bfseries\sffamily}
\RenewDocumentCommand{\cftloftitlefont}{}{\LARGE\bfseries\sffamily}
\RenewDocumentCommand{\cftlottitlefont}{}{\LARGE\bfseries\sffamily}
\RenewDocumentCommand{\cftchapfont}{}{\large\sffamily\bfseries}
\RenewDocumentCommand{\cftsecfont}{}{\normalsize}
\RenewDocumentCommand{\cftsubsecfont}{}{\normalsize}

% 章の項目もドットでページ番号までを繋ぐ
%\renewcommand{\cftchapleader}{\cftdotfill{\cftchapdotsep}}
%\renewcommand{\cftchapdotsep}{\cftdotsep}
\renewcommand{\cftdotsep}{0.5}

% ------------------------------------------------------------------------------
% 論文全体の概要
% ------------------------------------------------------------------------------
\ExplSyntaxOn
\cs_new_protected:Npn \__sdsthesis_setup_abstract_title: {
  {\bfseries\sffamily\large {\tl_use:N \l__sdsthesis_abstract_name_tl}}
}

\NewDocumentEnvironment{abstract}{}{%
  \thispagestyle{empty}
  \vspace*{40truemm}
  \begin{center}
    \__sdsthesis_setup_abstract_title:
  \end{center}
  \par
}{%
  \par
  \clearpage
}

\ExplSyntaxOff

% ------------------------------------------------------------------------------
% 各章の概要
% ------------------------------------------------------------------------------
\NewDocumentCommand{\textitjp}{m}{%
  \makebox[2.25zw][l]{%
    \vphantom{#1}\rotatebox{-48.8}{
      \scalebox{0.875}[1.143]{
        \rotatebox{41.2}{
          \smash{\rlap{#1}}
        }
      }
    }
  }
}

\ExplSyntaxOn
  \dim_const:Nn \c__sdsthesis_chapabst_below_skip_dim {5mm}
  \NewDocumentEnvironment{chapabst}{}{%
    \setlength\rightskip{1in}%
    \begin{small}\noindent\textbf{\textsf{\tl_use:N \l__sdsthesis_chapabst_name_tl :}}~
  }{%
    \end{small}\vspace{\dim_use:N \c__sdsthesis_chapabst_below_skip_dim}
  }
\ExplSyntaxOff

% ------------------------------------------------------------------------------
% ページヘッダの制御
% ------------------------------------------------------------------------------

% ヘッダの下の横線
\pagestyle{fancy}
\fancyhf{}

% ヘッダの内容
\fancyhead[RO]{\rightmark}
\fancyhead[LE]{\leftmark}
\fancyfoot[C]{--\,\thepage\,--}

\renewcommand{\headrulewidth}{.4pt}

\fancypagestyle{plain}{
  \fancyhead{}
  \renewcommand{\headrulewidth}{0pt}
}

%ヘッダ記述。 ~ で章・節番号とそのタイトルの間のスペースを調整
\ExplSyntaxOn
\bool_if:NF \l__sdsthesis_english_bool {
  \RenewDocumentCommand{\chaptermark}{m}{\markboth{第\,\thechapter\,章\quad #1}{}}
  \RenewDocumentCommand{\sectionmark}{m}{\markright{\thesection\quad #1}{}}
  \AddToHook{env/appendices/begin}{%
    \RenewDocumentCommand{\chaptermark}{m}{\markboth{付録\,\thechapter\quad #1}{}}
  }
}
\ExplSyntaxOff

% plainスタイルを再定義してheaderが章の最初の出ないようにする
% https://tex.stackexchange.com/questions/117328/fancyhdr-does-not-apply-same-header-footer-on-chapter-and-non-chapter-pages
\fancypagestyle{plain}{%
  \fancyhead{}%
  \renewcommand{\headrulewidth}{0pt}% Line at the header invisible
}

% ------------------------------------------------------------------------------
%謝辞
% ------------------------------------------------------------------------------
\ExplSyntaxOn

\cs_new_protected:Npn \__sdsthesis_setup_acks: {
  \RenewDocumentCommand{\chaptermark}{m}{
    \markboth{\tl_use:N \l__sdsthesis_ack_name_tl}{}
  }
  \chapter*{\tl_use:N \l__sdsthesis_ack_name_tl}
  \addcontentsline{toc}{chapter}{\tl_use:N \l__sdsthesis_ack_name_tl}
}

\NewDocumentEnvironment{acks}{}{
  \__sdsthesis_setup_acks:
}{}

\ExplSyntaxOff

% ------------------------------------------------------------------------------
% 目次の設定
% ------------------------------------------------------------------------------
% 目次に乗せる項目を\subsection まで索引を作成する。
\setcounter{tocdepth}{2}

% ------------------------------------------------------------------------------
% 数式前後のマージンの設定
% ------------------------------------------------------------------------------
\AtBeginDocument{\setlength{\abovedisplayskip}{8mm}}
\AtBeginDocument{\setlength{\abovedisplayshortskip}{8mm}}
\AtBeginDocument{\setlength{\belowdisplayskip}{8mm}}
\AtBeginDocument{\setlength{\belowdisplayshortskip}{8mm}}
\NewDocumentCommand{\adjustdisplayskips}{m}{%
  \setlength{\abovedisplayskip}{#1}
  \setlength{\abovedisplayshortskip}{#1}
  \setlength{\belowdisplayskip}{#1}
  \setlength{\belowdisplayshortskip}{#1}
}

% ------------------------------------------------------------------------------
% 箇条書きの設定
% ------------------------------------------------------------------------------
\RequirePackage{enumitem}
\setlist{
  itemsep=1pt,
  parsep=0pt,
  labelsep=3mm
}

\setlist[itemize]{
  label=$\vcenter{\hbox{$\bullet$}}$,
}

\setlist[enumerate]{
  label={\bfseries\sffamily\arabic*.}
}

% ------------------------------------------------------------------------------
% 図表の設定
% ------------------------------------------------------------------------------
\RequirePackage{caption}
\captionsetup[figure]{format=plain, labelformat=simple, labelsep=quad, labelfont={bf,sf}, font=small, justification=justified}
\captionsetup[table]{format=plain, labelformat=simple, labelsep=quad, labelfont={bf,sf}, font=small, justification=justified}
\captionsetup[lstlisting]{format=plain, labelformat=simple, labelsep=quad, labelfont={bf,sf}, font=small, justification=justified}

\RequirePackage{floatrow}
\floatsetup[figure]{capposition=bottom}
\floatsetup[table]{capposition=top}
\floatsetup[lstlisting]{capposition=top}

% ------------------------------------------------------------------------------
% ソースコードの設定
% ------------------------------------------------------------------------------
\RequirePackage{listings}
\RequirePackage{jvlisting}

\ExplSyntaxOn
  \bool_if:NTF \l__sdsthesis_english_bool {
    \RenewDocumentCommand{\lstlistingname}{}{Listing}
  }{
    \RenewDocumentCommand{\lstlistingname}{}{リスト}
  }
\ExplSyntaxOff

\lstset{
  basicstyle=\ttfamily\footnotesize,
  commentstyle=\textit,
  classoffset=1,
  keywordstyle=\bfseries,
  frame=trbl,
  framesep=5pt,
  xrightmargin=0pt,
  xleftmargin=5pt,
  showstringspaces=false,
  columns=[l]{fullflexible},
  stepnumber=1,
  numberstyle=\footnotesize,
  tabsize=2,
  breaklines=true,
}

% ------------------------------------------------------------------------------
% 枠付き段落
% ------------------------------------------------------------------------------
\RequirePackage{mdframed}
\NewDocumentEnvironment{titlebox}{m}{%
  \mdfsetup{
    frametitle={\colorbox{white}{\space#1\space}},
    innertopmargin=0,
    frametitleaboveskip=-.8\ht\strutbox,
    frametitlealignment=\raggedright
  }
  \begin{mdframed}
}{%
  \end{mdframed}
}

% ------------------------------------------------------------------------------
% リンクの設定
% ------------------------------------------------------------------------------
\definecolor{LinkColor}{rgb}{0.2,0.5,1.0}
\ExplSyntaxOn
\cs_new_protected:Npn \__sdsthesis_load_hyperref: {
  % PDF/A用のメタデータはpdfaオプションを指定したときのみ埋め込む
  \bool_if:NTF \l__sdsthesis_pdfa_bool {
    \RequirePackage[pdfa=true]{hyperref}
    \RequirePackage{hyperxmp}
    \hypersetup{pdfapart=3, pdfaconformance=u}
  }{
    \RequirePackage{hyperref}
  }
  % PDFのメタデータに文書の言語を設定
  \bool_if:NTF \l__sdsthesis_english_bool {
    \hypersetup{pdflang=en}
  }{
    \hypersetup{pdflang=ja}
  }
}

\ExplSyntaxOff

% ***** CleverRefの設定 *****
\ExplSyntaxOn
\cs_new_protected:Npn \__sdsthesis_cref_format_jp:nnn #1#2#3 {
  \crefformat{#1}{##2#2\,##1\,#3##3}%
  \crefrangeformat{#1}{##3#2\,##1\,#3##4から##5#2\,##2\,#3##6}%
  \crefmultiformat{#1}{##2#2\,##1\,#3##3}{ならびに##2#2\,##1\,#3##3}{、##2#2\,##1\,#3##3}{ならびに##2#2\,##1\,#3##3}
}

\cs_new_protected:Npn \__sdsthesis_setup_cref: {
  \bool_if:NF \l__sdsthesis_english_bool {
    \__sdsthesis_cref_format_jp:nnn{equation}{式}{}
    \__sdsthesis_cref_format_jp:nnn{figure}{図}{}
    \__sdsthesis_cref_format_jp:nnn{table}{表}{}
    \__sdsthesis_cref_format_jp:nnn{algorithm}{アルゴリズム}{}
    \__sdsthesis_cref_format_jp:nnn{chapter}{第}{章}
    \__sdsthesis_cref_format_jp:nnn{section}{第}{節}
    \__sdsthesis_cref_format_jp:nnn{subsection}{第}{項}
    \__sdsthesis_cref_format_jp:nnn{appendix}{付録}{}
    \__sdsthesis_cref_format_jp:nnn{subappendix}{付録}{}
    \__sdsthesis_cref_format_jp:nnn{subsubappendix}{付録}{}
    \__sdsthesis_cref_format_jp:nnn{subsubsubappendix}{付録}{}
    \__sdsthesis_cref_format_jp:nnn{theorem}{定理}{}
    \__sdsthesis_cref_format_jp:nnn{lemma}{補題}{}
    \__sdsthesis_cref_format_jp:nnn{definition}{定義}{}
    \__sdsthesis_cref_format_jp:nnn{proposition}{命題}{}

    \newcommand{\crefpairconjunction}{ならびに}
    \newcommand{\crefrangeconjunction}{から}
    \newcommand{\crefmiddleconjunction}{、}
    \newcommand{\creflastconjunction}{、ならびに}
  }
}
\ExplSyntaxOff

\ExplSyntaxOn
\cs_new_protected:Npn \__sdsthesis_setup_theorems: {
  \theoremstyle{definition}
  \bool_if:NTF \l__sdsthesis_english_bool {
    \newtheorem{theorem}{Theorem}
    \newtheorem{lemma}{Lemma}
    \newtheorem*{proof*}{Proof}
    \newtheorem{definition}{Definition}
    \newtheorem{proposition}{Proposition}
  }{
    \newtheorem{theorem}{定理}
    \newtheorem{lemma}{補題}
    \newtheorem*{proof*}{証明}
    \newtheorem{definition}{定義}
    \newtheorem{proposition}{命題}
  }
}

\cs_new_protected:Npn \__sdsthesis_setup_references: {
  \__sdsthesis_load_hyperref:

  \hypersetup{
    pdfencoding=auto,
    backref=true,
    bookmarks=true,
    bookmarksnumbered=true,
    bookmarksopen=true,
    colorlinks=true,
    linktocpage=true,         % 目次においてページ番号にリンクをつける
    linkcolor=RoyalBlue,      % 主に章や節の番号のリンク
    citecolor=RoyalBlue,      % 文献の引用
    urlcolor=Magenta,         % URL
  }

  \RequirePackage[noabbrev,capitalize]{cleveref}

  \renewcommand{\thesection}{\thechapter.\arabic{section}}
  \renewcommand{\thesubsection}{\thechapter.\arabic{section}.\arabic{subsection}}

  \__sdsthesis_setup_theorems:
  \__sdsthesis_setup_cref:
}

\AddToHook{begindocument/before}{
  \__sdsthesis_setup_references:
}

